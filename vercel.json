{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "src/dist",
  "functions": {
    "api/[[...route]].ts": { "includeFiles": "{data/**,backend/db/certs/**}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[[...route]]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
