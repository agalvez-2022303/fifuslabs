{
  "name": "physicslab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "src"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=src",
    "server": "node server/index.js",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "build": "npm run typecheck:backend && npm run build --workspace=src",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "migrate:temas": "tsx scripts/migrate-temas.ts",
    "typecheck:backend": "tsc --project tsconfig.json",
    "lint:backend": "eslint backend api packages/shared-types/src scripts/migrate-temas.ts src/data/temas/types.ts src/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/node": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "katex": "^0.18.10",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.0"
  }
}
