{
  "name": "physicslab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "src"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=src",
    "server": "node server/index.js",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "build": "npm run build --workspace=src",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "migrate:temas": "tsx scripts/migrate-temas.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/node": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
