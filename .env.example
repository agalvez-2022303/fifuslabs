# Backend temporal: copiar a .env en la raíz. No contiene credenciales.
NODE_ENV=development
# Solo habilitar localmente; producción y Vercel ignoran los headers x-dev-*.
DEV_AUTH=false

# postgres se selecciona automáticamente si DATABASE_URL está definido; json sirve como fallback local.
CONTENT_REPOSITORY=
DATABASE_URL=
# Para conexiones remotas se exige TLS con verificación de certificado.
DATABASE_SSL=true
# Opcional: certificado CA PEM de Supabase si no está en el almacén del sistema.
DATABASE_CA_CERT=
SUPABASE_URL=https://cxlabpfgmusspsdeasrw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Alternativas legacy: SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Crear el primer maestro por CLI (no exponer estas variables en VITE_*).
# Alternativa: BOOTSTRAP_USER_ID de un usuario existente en Supabase Auth.
BOOTSTRAP_USER_ID=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Credenciales de un maestro ya existente, usadas solo por `npm run verify:panel`
# para validar el login real. Si faltan, los flujos autenticados se prueban en
# modo JSON + DevAuth. No son necesarias para usar la aplicación.
SUPABASE_PANEL_EMAIL=
SUPABASE_PANEL_PASSWORD=
